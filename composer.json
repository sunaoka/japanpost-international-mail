{
    "name": "sunaoka/japanpost-international-mail",
    "type": "project",
    "description": "Japan Post's International Mail Service availability by country",
    "license": "MIT",
    "keywords": [],
    "authors": [
        {
            "name": "sunaoka",
            "email": "sunaoka@pocari.org"
        }
    ],
    "require": {
        "php": "8.4.*",
        "ext-intl": "*",
        "symfony/browser-kit": "^7.3.2",
        "symfony/css-selector": "^7.3.0",
        "symfony/http-client": "^7.3.2"
    }
    ,
    "require-dev": {
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Sunaoka\\JapanPostInternationalMail\\": ["bin", "src"]
        },
        "files": [
            "./src/Support/helpers.php"
        ]
    },
    "config": {
        "bump-after-update": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
